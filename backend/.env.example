# LLM provider: mock (offline, deterministic) | claude
LLM_PROVIDER=mock
# Used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Embeddings: auto (sentence-transformers if installed) | st | hash
REGLENS_EMBEDDER=auto
# Vector store: auto (ChromaDB if installed) | chroma | numpy
REGLENS_VECTOR_STORE=auto

# Delay per transaction during streamed batch analysis (ms) so the live feed is watchable
ANALYSIS_PACE_MS=12
# Frontend dev origin(s) allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
